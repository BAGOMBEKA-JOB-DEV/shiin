{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shiin:schema:policy:v1",
  "title": "Shiin policy snapshot",
  "type": "object",
  "required": ["schema", "layers", "default"],
  "properties": {
    "schema": { "type": "string", "const": "shiin.policy/v1-draft.1" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "digest", "rules"],
        "properties": {
          "name": { "type": "string", "enum": ["built-in", "user", "workspace"] },
          "digest": { "$ref": "urn:shiin:schema:common:v1#/$defs/sha256" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "effect"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "effect": { "type": "string", "enum": ["allow", "deny", "pending"] },
                "action_types": { "type": "array", "items": { "type": "string" } },
                "resources": { "type": "array", "items": { "type": "string" } },
                "commands": { "type": "array", "items": { "type": "string" } },
                "agents": { "type": "array", "items": { "type": "string" } },
                "reason": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "default": { "type": "string", "enum": ["deny", "pending"] }
  },
  "additionalProperties": false
}