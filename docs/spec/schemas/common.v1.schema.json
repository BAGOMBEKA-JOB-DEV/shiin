{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shiin:schema:common:v1",
  "title": "Shiin common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "effect": {
      "type": "object",
      "required": ["kind", "value", "confidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "confidence": { "type": "string", "enum": ["exact", "inferred", "opaque"] }
      },
      "additionalProperties": false
    },
    "agent_identity": {
      "type": "object",
      "required": ["id", "assurance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "assurance": {
          "type": "string",
          "enum": ["asserted", "attested-local", "attested-os-user", "attested-crypto"]
        }
      },
      "additionalProperties": false
    }
  }
}