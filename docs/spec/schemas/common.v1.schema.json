{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shiin:schema:common:v1",
  "title": "Shiin common definitions",
  "$defs": {
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "effect": {
      "type": "object",
      "required": [
        "kind",
        "value",
        "confidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "exact",
            "inferred",
            "opaque"
          ]
        },
        "action_type": {
          "description": "The action type this effect represents, when it differs from the request's own.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "agent_identity": {
      "type": "object",
      "required": [
        "id",
        "assurance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "assurance": {
          "type": "string",
          "enum": [
            "asserted",
            "attested-local",
            "attested-os-user",
            "attested-crypto"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
