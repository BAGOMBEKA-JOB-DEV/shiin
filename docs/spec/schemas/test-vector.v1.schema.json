{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shiin:schema:test-vector:v1",
  "title": "Shiin test vector",
  "type": "object",
  "required": ["schema", "id", "name", "action_request", "policy", "expected"],
  "properties": {
    "schema": { "type": "string", "const": "shiin.test-vector/v1-draft.1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "action_request": { "$ref": "urn:shiin:schema:action-request:v1" },
    "policy": { "$ref": "urn:shiin:schema:policy:v1" },
    "expected": {
      "type": "object",
      "required": ["decision", "reason"],
      "properties": {
        "decision": { "type": "string", "enum": ["allow", "deny", "pending"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}